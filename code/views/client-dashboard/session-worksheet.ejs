<!DOCTYPE html>
<html>

<head>

    <title>Session Preparation</title>

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>


    <nav class="top-nav">
        <a class="logo" href="/client-dashboard/main">
            <%= site.businessName %>
        </a>
    </nav>

    <section class="container" style="margin-top:150px;">
        <main class="dashboard-main">



            <h1>
                <%= resource.title %>
            </h1>


            <p>
                <%= resource.summary %>
            </p>

            <% const savedAnswers = answers || new Map(); %>

            <% if (isAdmin || !editing) { %>

                <% resource.questions.forEach(question=> { %>

                    <div class="card worksheet-question">

                        <h3>
                            <%= question.question %>
                        </h3>


                        <p>
                            <%= savedAnswers.get(question.id) %>
                        </p>


                    </div>


                    <% }) %>

                        <% if (!isAdmin) { %>
                            <div style="margin-top: 32px; text-align: center">
                                <a class="button" href="?edit=true">Edit Worksheet</a>
                            </div>
                        <% } %>

                        <% } else { %>

                            <form method="POST" action="/client-dashboard/sessions/<%= bookingUid %>/<%= status %>/worksheet">

                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">




                                <% resource.questions.forEach(question=> { %>


                                    <div class="card worksheet-question">


                                        <label for="<%= question.id %>">

                                            <%= question.question %>

                                        </label>

                                        <% if (question.placeholder) { %>

                                            <p>
                                                <%= question.placeholder %>
                                            </p>

                                            <% } %>

                                                <% if (question.type==="text" ) { %>

                                                    <input id="<%= question.id %>" name="<%= question.id %>" type="text"
                                                        value="<%= savedAnswers.get(question.id) || '' %>"
                                                        placeholder="Write your response here...">


                                                    <% } else { %>

                                                        <textarea id="<%= question.id %>" name="<%= question.id %>"
                                                            placeholder="Write your response here..."><%= savedAnswers.get(question.id) || '' %></textarea>


                                                        <% } %>
                                    </div>

                                    <% }) %>

                                        <div class="dashboard-actions">

                                            <div style="margin-top: 32px; text-align: center">
                                                <a class="button button-secondary" href="?">Cancel</a>
                                                <button type="submit" class="button primary">

                                                    Save Worksheet

                                                </button>
                                            </div>

                                        </div>

                            </form>

                            <% } %>

                            <% if (!isAdmin) { %>
                                <div style="margin-top: 32px; text-align: center">
                                    <a class="button" href="/client-dashboard/sessions">Back to
                                        Sessions</a>
                                </div>

                                <% } else { %>
                                <div style="margin-top: 32px; text-align: center">
                                    <a class="button button-secondary" href="/admin/clients/<%= client._id %>">← Back to
                                        <%= client.preferredName || client.firstName %></a>
                                </div>

                                <% } %>

        </main>

    </section>

</body>

</html>