<!DOCTYPE html>
<html>

<head>

    <title>Testimonial Questions</title>

    <link rel="stylesheet" href="/css/dashboard.css">

</head>

<body>

    <%- include("../partials/dashboard-nav") %>

    <div class="dashboard-layout">

        <%- include("partials/admin-sidebar", { currentPage: "testimonial-questions" }) %>

        <main class="dashboard-main">

            <div class="admin-page-header">
                <div>
                    <h1>Testimonial Questions</h1>
                    <p>The prompts clients see on the testimonial submission form in their dashboard. Order
                        controls the sequence they're shown in (lowest first).</p>
                </div>

                <a class="button" href="/admin/testimonial-questions/new">
                    + New Question
                </a>
            </div>

            <% if (!testimonialQuestions.length) { %>

                <div class="admin-empty">
                    <p>No questions yet. Add one to get started.</p>
                </div>

            <% } else { %>

                <div class="admin-list">

                    <% testimonialQuestions.forEach(testimonialQuestion => { %>

                        <div class="admin-row">

                            <div class="admin-row-main">

                                <div class="admin-row-title">
                                    <%= testimonialQuestion.question %>
                                    <span class="badge <%= testimonialQuestion.active ? 'badge-active' : 'badge-inactive' %>">
                                        <%= testimonialQuestion.active ? "Active" : "Inactive" %>
                                    </span>
                                </div>

                                <div class="admin-row-meta">
                                    Order: <%= testimonialQuestion.order %>
                                </div>

                            </div>

                            <div class="admin-row-actions">

                                <a class="button button-secondary button-sm" href="/admin/testimonial-questions/<%= testimonialQuestion._id %>/edit">
                                    Edit
                                </a>

                                <form method="POST" action="/admin/testimonial-questions/<%= testimonialQuestion._id %>/toggle">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button class="button button-secondary button-sm">
                                        <%= testimonialQuestion.active ? "Deactivate" : "Activate" %>
                                    </button>
                                </form>

                                <form method="POST" action="/admin/testimonial-questions/<%= testimonialQuestion._id %>/delete"
                                    onsubmit="return confirm('Delete this question? Any past testimonial answers to it are kept but will no longer show anywhere.')">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button class="button button-danger button-sm">
                                        Delete
                                    </button>
                                </form>

                            </div>

                        </div>

                    <% }) %>

                </div>

            <% } %>

        </main>

    </div>

</body>

</html>
