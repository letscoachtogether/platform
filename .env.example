# --- Database & session ---
MONGODB_URI=

# Signs session cookies — without a real value here, sessions fall back to an
# insecure shared default. Auto-generated by `npm run setup`; on Render this
# is auto-generated by render.yaml instead and never needs to be set by hand.
# Generate one manually with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# --- Site identity — shown across the public site, emails, and metadata ---
BUSINESS_NAME=Your Coaching Business
FOUNDER_NAME=Your Name
SITE_TAGLINE=1:1 coaching to help you move forward with clarity.

CONTACT_EMAIL=you@example.com
# Where the "Book a session" links on the public site point.

BOOKING_URL=https://cal.com/your-username
# The public URL this app is deployed at — no trailing slash.

BASE_URL=http://localhost:3000

# --- Email (Resend — resend.com) ---
RESEND_API_KEY=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Scheduling (Cal.com) ---
CAL_API_KEY=

# --- Cron / scheduled tasks (optional) ---
# Authenticates GET /api/cron/session-reminders — lets an external scheduler
# (a GitHub Actions workflow, Render's own Cron Jobs, cron-job.org, etc.)
# trigger the session-reminder check on a timer, and doubles as a keep-alive
# ping on hosts that spin the app down when idle (Render's free tier).
# Auto-generated by `npm run setup`; generate by hand with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- First admin account (optional) ---
# Only needed on a host with no shell access (e.g. Render's free tier) —
# locally, use `npm run setup` or `npm run create-admin` instead. If both are
# set, an admin account is created from them on first boot; once an admin
# exists, these are ignored on every later boot, so they're safe to leave set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

NODE_ENV=development
PORT=3000
