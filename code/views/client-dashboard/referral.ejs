<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Refer a Friend | <%= site.businessName %></title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <nav class="top-nav">
        <a class="logo" href="/client-dashboard/main">
            <%= site.businessName %>
        </a>
    </nav>

    <section class="container" style="margin-top:150px;">

        <h1>Refer a Friend</h1>

        <p>
            Know someone who'd benefit from coaching? Send us their info and we'll reach out.
        </p>

        <form method="POST" action="/client-dashboard/referral" class="worksheet-form">

            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="card worksheet-question">

                <label for="friendName">Their Name</label>
                <input id="friendName" name="friendName" type="text" placeholder="Write your response here..." required>

                <label for="friendEmail" style="margin-top:20px; display:block;">Their Email</label>
                <input id="friendEmail" name="friendEmail" type="email" placeholder="Write your response here..." required>

                <label for="note" style="margin-top:20px; display:block;">Note (optional)</label>
                <textarea id="note" name="note" placeholder="Anything we should know before reaching out?"></textarea>

            </div>

            <div class="dashboard-actions">
                <div style="margin-top: 32px; text-align: center">
                    <button type="submit" class="button primary">
                        Send Referral
                    </button>
                </div>
            </div>

        </form>

        <% if (referrals.length) { %>

            <h2 style="margin-top:48px;">Your Referrals</h2>

            <% referrals.forEach(r => { %>

                <div class="card worksheet-question">
                    <p><strong><%= r.friendName %></strong> — <%= r.friendEmail %></p>
                    <% if (r.note) { %>
                        <p>“<%= r.note %>”</p>
                    <% } %>
                    <p style="color: var(--muted);">
                        Sent <span data-datetime="<%= r.createdAt.toISOString() %>" data-format="date-short">
                            <%= r.createdAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %>
                        </span>
                    </p>
                </div>

            <% }) %>

        <% } %>

        <div style="margin-top: 16px; text-align: center">
            <a class="button button-secondary" href="/client-dashboard/main">Back to Dashboard</a>
        </div>

    </section>

    <script src="/js/localizeDates.js"></script>

</body>

</html>
