<!DOCTYPE html>
<html>

<head>

    <title>Session Notes</title>

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>


    <nav class="top-nav">
        <a class="logo" href="/client-dashboard/main">
            <%= site.businessName %>
        </a>
    </nav>



    <section class="container" style="margin-top:150px;">

        <h1>
            Session Notes:
            <span data-datetime="<%= new Date(start).toISOString() %>" data-format="date-short">
                <%= new Date(start).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %>
            </span>
        </h1>


        <main class="dashboard-main">

            <% if (notes.sections.length) { %>

                <% notes.sections.forEach(section => { %>
            
                    <div class="card worksheet-question">
            
                        <h3><%= section.title %></h3>
            
                        <ul>
            
                            <% section.items.forEach(item => { %>
            
                                <li><%= item %></li>
            
                            <% }) %>
            
                        </ul>
            
                    </div>
            
                <% }) %>
            
            <% } else { %>
            
                <p>No notes have been added for this session yet.</p>
            
            <% } %>
            
                      
        </main>

    </section>

    <div style="margin-top: 32px; text-align: center">
        <a class="button"
            href="/client-dashboard/sessions">Back to
            Sessions</a>
    </div>

    <script src="/js/localizeDates.js"></script>

</body>

</html>